{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cords",
  "version": "0.1.0",
  "identifier": "chat.cords.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "npm run build"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cords — Right on the wire",
        "width": 1180,
        "height": 760,
        "minWidth": 620,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "resources": { "../../../migrations/sqlite/": "migrations/sqlite/" },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "A self-hosted encrypted communication client"
  }
}
