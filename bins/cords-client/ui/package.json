{
  "name": "cords-client-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri:dev": "cd .. && tauri dev",
    "tauri:build": "cd .. && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@lucide/svelte": "1.52.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@sveltejs/vite-plugin-svelte": "6.2.0",
    "@tauri-apps/cli": "2.12.0",
    "eslint": "9.35.0",
    "eslint-plugin-svelte": "3.12.4",
    "globals": "16.4.0",
    "jsdom": "30.1.2",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte-check": "4.3.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
