        "vault": "unlocked",
        "received": [
          "m1",
          "m2"
        ],
        "missing": [
          "m0"
        ]
      },
      "steps": [
        "retain received channel history",
        "leave/remove server",
        "disconnect network",
        "restart and unlock vault"
