      "expected": {
        "readable": [
          "m1",
          "m2"
        ],
        "fetched": [],
        "requires_membership": false,
        "requires_server": false,
        "default_expiry": "none",
        "access": "read-only"
      }
    },
    {
      "id": "archive-courier-unavailable",
      "checkpoint": "C5d",
      "evidence": "specification-only",
      "initial": {
        "retained_DM": "D"
      },
      "steps": [
        "change courier",
        "make old and new courier unavailable"
      ],
      "expected": {
        "DM_identity": "D",
        "retained_history": "accessible while vault unlocked",
